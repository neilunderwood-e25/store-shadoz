# Copy to .env.local and fill in the tokens. .env.local is ignored by Git.
# Shopify admin → Sales channels → Headless → Shadoz Next.js → Storefront API.

SHOPIFY_STORE_DOMAIN=shadoz-dev-k7sis72f.myshopify.com
SHOPIFY_STOREFRONT_API_VERSION=2026-10

# Private access token: server-side only. Never commit it or paste it anywhere public.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# Public access token: safe in the browser; for client-side features later.
NEXT_PUBLIC_SHOPIFY_STOREFRONT_PUBLIC_TOKEN=
